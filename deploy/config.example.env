# Copy to deploy/config.env (ignored by Git) and fill in.
# Secrets (SMTP password, Telegram bot token) are NOT here: export them as
# SMTP_PASSWORD and TELEGRAM_BOT_TOKEN before running install.sh, they go
# straight into the Kubernetes Secret "alert-secrets".

SMTP_HOST=smtp.example.com
SMTP_FROM=alerts@example.com
SMTP_USER=alerts@example.com
ALERT_EMAIL_TO=oncall@example.com
TELEGRAM_CHAT_ID=-1001234567890
# Base URL of Grafana used in alert links
GRAFANA_URL=https://grafana.stand.example.com
